# LabelPulse Discord Bot — Environment Variables
# Copia questo file come .env e compila i valori

# Discord Bot Token (da Discord Developer Portal → Bot → Token)
DISCORD_BOT_TOKEN=your_bot_token_here

# ID del server Discord (clicca destro sul server → Copia ID sviluppatore)
DISCORD_GUILD_ID=your_guild_id_here

# ID del canale #benvenuto (clicca destro sul canale → Copia ID sviluppatore)
WELCOME_CHANNEL_ID=your_welcome_channel_id_here

# ID del canale #beta-announcements
ANNOUNCEMENTS_CHANNEL_ID=your_announcements_channel_id_here

# ID del ruolo Beta Tester (da Impostazioni Server → Ruoli → Copia ID)
BETA_TESTER_ROLE_ID=your_beta_tester_role_id_here

# ID del ruolo Newcomer
NEWCOMER_ROLE_ID=your_newcomer_role_id_here

# ID del ruolo Founder
FOUNDER_ROLE_ID=your_founder_role_id_here

# Link allo screening form (da compilare dopo Punto 0.5)
SCREENING_FORM_URL=https://tally.so/r/your-form-id

# Link al NDA (da compilare dopo Punto 0.5)
NDA_URL=https://labelpulse.vercel.app/legal/nda

# Versione attuale dell'app (per comando /status)
APP_VERSION=2.4.0
