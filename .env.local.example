# ==============================================
# LabelPulse - Variabili d'ambiente per Supabase
# ==============================================
#
# 1. Crea un progetto gratuito su https://supabase.com
# 2. Vai in Project Settings → API
# 3. Copia la "Project URL" e la "anon public" key
# 4. Incolla qui sotto
# 5. Rinomina questo file in .env.local
#
# IMPORTANTE: Dopo aver configurato queste variabili localmente,
# aggiungile ANCHE nel dashboard Vercel:
# Vercel → Il tuo progetto → Settings → Environment Variables
#
# ==============================================

NEXT_PUBLIC_SUPABASE_URL=https://tuo-progetto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=la-tua-anon-key-qui

# ==============================================
# In-app email sender (Resend) — OPZIONALE
# ==============================================
#
# Permette agli utenti di inviare email direttamente dall'app senza
# connettere Gmail. L'API route /api/email/send usa Resend.
#
# 1. Crea un account gratuito su https://resend.com
# 2. Verifica il tuo dominio (es. labelpulse.app) in Resend → Domains
# 3. Genera una API key in Resend → API Keys
# 4. Incolla qui sotto
# 5. Aggiungi le stesse variabili nel dashboard Vercel
#
# Se NON configuri queste variabili, l'app funziona comunque con Gmail API.
# Il bottone "Invia dall'app" non viene mostrato nella UI.
#
RESEND_API_KEY=
EMAIL_FROM=LabelPulse <noreply@labelpulse.app>

