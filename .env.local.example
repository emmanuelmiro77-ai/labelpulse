# ==============================================
# LabelPulse - Variabili d'ambiente per Supabase
# ==============================================
#
# 1. Crea un progetto gratuito su https://supabase.com
# 2. Vai in Project Settings → API
# 3. Copia la "Project URL" e la "anon public" key
# 4. Incolla qui sotto
# 5. Rinomina questo file in .env.local
#
# IMPORTANTE: Dopo aver configurato queste variabili localmente,
# aggiungile ANCHE nel dashboard Vercel:
# Vercel → Il tuo progetto → Settings → Environment Variables
#
# ==============================================

NEXT_PUBLIC_SUPABASE_URL=https://tuo-progetto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=la-tua-anon-key-qui

# ==============================================
# In-app email sender (Resend) — OPZIONALE
# ==============================================
#
# Permette agli utenti di inviare email direttamente dall'app senza
# connettere Gmail. L'API route /api/email/send usa Resend.
#
# 1. Crea un account gratuito su https://resend.com
# 2. Verifica il tuo dominio (es. labelpulse.app) in Resend → Domains
# 3. Genera una API key in Resend → API Keys
# 4. Incolla qui sotto
# 5. Aggiungi le stesse variabili nel dashboard Vercel
#
# Se NON configuri queste variabili, l'app funziona comunque con Gmail API.
# Il bottone "Invia dall'app" non viene mostrato nella UI.
#
RESEND_API_KEY=
EMAIL_FROM=LabelPulse <onboarding@resend.dev>

# ==============================================
# Bugsnag — Error tracking + breadcrumbs
# ==============================================
#
# Free tier (verified 2026-06-26): 7.500 errori/mese forever, 1 seat,
# 7 giorni retention, source maps upload incluso.
#
# Setup:
#   1. Crea account gratuito su https://www.bugsnag.com
#   2. Skip il trial di 14 giorni (non serve per il free plan)
#   3. Crea nuovo progetto → seleziona "React" (browser)
#   4. Copia la "API Key" (32 caratteri hex, es. "1fa4d8a8...")
#      in NEXT_PUBLIC_BUGSNAG_API_KEY
#   5. (Opzionale) Per uso server-side separato: crea un'altra API key
#      e mettila in BUGSNAG_API_KEY (più privata, non nel bundle client)
#
# NOTA: nella nostra config single-project usiamo la STESSA chiave per entrambe
# le variabili. Bugsnag permette di usare una chiave pubblica su entrambi i lati.
#
# Senza NEXT_PUBLIC_BUGSNAG_API_KEY, Bugsnag è disattivato — l'app funziona normalmente.
# Vedrai il primo errore apparire in dashboard dopo aver deployato con le env vars configurate.
#
# NOTA: in development gli errori NON vengono inviati (enabledReleaseStages=['production'])
# per non inquinare il dashboard. Per testare in dev, cambia temporaneamente
# enabledReleaseStages in src/lib/bugsnag.ts
#
NEXT_PUBLIC_BUGSNAG_API_KEY=
BUGSNAG_API_KEY=

# ==============================================
# PostHog — Analytics + feature flags + session replay
# ==============================================
#
# Free tier: 1M eventi/mese, 5K session recording/mese, sufficiente per beta.
# Setup:
#   1. Crea account su https://posthog.com (cloud free o self-hosted)
#   2. Crea nuovo progetto → copia "Project API Key"
#   3. Incolla qui sotto
#   4. L'host di default è https://us.i.posthog.com (cloud US)
#      Se usi cloud EU: NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
#
# Senza NEXT_PUBLIC_POSTHOG_KEY, PostHog è disattivato — nessun evento viene tracciato.
# In development, gli eventi NON vengono inviati di default (opt_out_capturing_by_default=true).
# Per testare in dev, imposta NEXT_PUBLIC_POSTHOG_FORCE=true
#
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
NEXT_PUBLIC_POSTHOG_FORCE=

# ==============================================
# Support Email — Beta phase
# ==============================================
#
# Email per supporto e contatto durante la beta.
# Attualmente usiamo un account Gmail temporaneo.
# Dopo la registrazione del dominio labelpulse.app (FASE 4),
# configureremo Cloudflare email routing → hello@labelpulse.app
#
SUPPORT_EMAIL=pulse.label.official@gmail.com

# ==============================================
# Discord Webhook — Feedback auto-forward
# ==============================================
#
# Quando un beta tester invia un bug report o una feature request,
# viene inoltrato automaticamente al canale Discord #bug-reports.
#
# Setup:
#   1. Vai nel tuo server Discord → #bug-reports → Impostazioni canale → Integrazioni → Webhook
#   2. Crea un nuovo webhook → copia l'URL
#   3. Incolla qui sotto
#   4. Aggiungi la stessa variabile nel dashboard Vercel
#
# Se non configurato, i feedback vengono salvati su Supabase ma non inoltrati a Discord.
#
DISCORD_FEEDBACK_WEBHOOK_URL=


