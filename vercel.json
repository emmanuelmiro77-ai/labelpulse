{
  "version": 2,
  "buildCommand": "npm run build",
  "functions": {
    "src/app/api/track-import/route.ts": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/cron/follow-up-reminders",
      "schedule": "0 7 * * *"
    },
    {
      "path": "/api/cron/weekly-recap",
      "schedule": "0 7 * * 1"
    }
  ]
}
