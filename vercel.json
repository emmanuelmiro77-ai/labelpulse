{
  "version": 2,
  "builds": [
    { "src": "package.json", "use": "@vercel/next" }
  ],
  "routes": [
    { "src": "/(.*)", "dest": "/" }
  ]
}
{
  "buildCommand": "npm run build",
  "crons": [
    {
      "path": "/api/cron/follow-up-reminders",
      "schedule": "0 7 * * *"
    },
    {
      "path": "/api/cron/weekly-recap",
      "schedule": "0 7 * * 1"
    }
  ]
}
